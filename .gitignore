# =================================================================
# Compliance Profile Generator - .gitignore
# =================================================================

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# Node.js (if you add tooling later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml

# Build output (if you add a build step later)
dist/
build/
out/
.next/
.nuxt/
.cache/

# IDE and editor folders
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~

# OS-specific
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Temporary files
*.log
*.tmp
*.bak
*.orig

# Local dev server artifacts
.parcel-cache/
.vite/

# Coverage reports (if you add tests later)
coverage/
.nyc_output/

# Misc
*.DS_Store
.history/
